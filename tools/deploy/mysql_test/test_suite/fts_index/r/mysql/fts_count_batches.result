drop table if exists fts_count_batches;
drop table if exists fts_count_composite;
create table fts_count_batches(id bigint primary key, category int, body longtext);
create fulltext index fti_count_empty on fts_count_batches(body) with parser beng;
select count(*) from fts_count_batches where match(body) against('alpha');
count(*)
0
drop index fti_count_empty on fts_count_batches;
insert into fts_count_batches values (1,1,'alpha beta'),(2,1,'alpha gamma'),(3,2,'beta delta'),(4,2,''),(5,3,null);
