create fulltext index fti_count_batches on fts_count_batches(body) with parser beng;
select count(*) from fts_count_batches where match(body) against('alpha beta');
count(*)
4
prepare fts_counter from 'select count(*) from fts_count_batches where match(body) against(?)';
set @fts_term='alpha';
execute fts_counter using @fts_term;
count(*)
3
set @fts_term='beta gamma';
execute fts_counter using @fts_term;
count(*)
3
deallocate prepare fts_counter;
select count(*) from fts_count_batches where match(body) against('alpha') and category=1;
count(*)
2
select count(*) from fts_count_batches where match(body) against('the and is');
count(*)
0
select count(*) from fts_count_batches where match(body) against('term000 term255 term256 term599');
count(*)
1
select count(*) from (select id from fts_count_batches where match(body) against('alpha') limit 1) v;
count(*)
1
select count(*) from (select id from fts_count_batches where match(body) against('alpha') limit 2 offset 1) v;
count(*)
2
select count(*) from (select id from fts_count_batches where match(body) against('alpha') limit 2 offset 20) v;
count(*)
0
select sum(id),min(id),max(id) from (select id from fts_count_batches where match(body) against('alpha') limit 2) v;
sum(id)	min(id)	max(id)
8	2	6
select count(*) from (select id from fts_count_batches where match(body) against('alpha') order by id desc limit 2) v where id>2;
count(*)
1
select id,round(match(body) against('alpha'),6) s from fts_count_batches where match(body) against('alpha') order by s desc,id;
id	s
6	0.549609
1	0.422865
2	0.422865
select count(*) from fts_count_batches where match(body) against('alpha')>0.5;
count(*)
1
select count(*) from fts_count_batches where match(body) against('+alpha -gamma' in boolean mode);
count(*)
2
select /*+ index(fts_count_batches primary) */ count(*) from fts_count_batches where match(body) against('alpha');
count(*)
3
select d.id,(select count(*) from fts_count_batches c where match(c.body) against('alpha') and c.category=d.category) cnt from fts_count_batches d order by d.id;
id	cnt
1	2
2	2
3	0
4	0
5	1
6	1
insert into fts_count_batches values(7,1,'alpha epsilon');
update fts_count_batches set body='beta zeta' where id=2;
delete from fts_count_batches where id=1;
select count(*),sum(id) from fts_count_batches where match(body) against('alpha');
count(*)	sum(id)
2	13
drop index fti_count_batches on fts_count_batches;
create fulltext index fti_count_batches on fts_count_batches(body) with parser beng;
select count(*),sum(id) from fts_count_batches where match(body) against('alpha');
count(*)	sum(id)
2	13
create table fts_count_composite(a varchar(16),b bigint,body longtext,primary key(a,b));
insert into fts_count_composite values('first',1,'alpha beta'),('second',2,'alpha gamma'),('third',3,'beta delta');
create fulltext index fti_count_composite on fts_count_composite(body) with parser beng;
select count(*) from fts_count_composite where match(body) against('alpha beta');
count(*)
3
select a,b,round(match(body) against('alpha'),6) s from fts_count_composite where match(body) against('alpha') order by s desc,a,b;
a	b	s
first	1	0.371622
second	2	0.371622
select count(*) from (select a,b from fts_count_composite where match(body) against('alpha') limit 1) v;
count(*)
1
select count(*) from (select a,b from fts_count_composite where match(body) against('alpha') limit 1 offset 1) v;
count(*)
1
select count(*) from (select a,b from fts_count_composite where match(body) against('alpha') limit 1) v where a='first';
count(*)
1
drop table fts_count_batches;
drop table fts_count_composite;
